// ===============================
// CHECK COUPON
// ===============================

app.post(
    "/api/coupon/check",
    auth,
    (req, res) => {

        const planId =
            Number(req.body.plan_id);

        const code =
            String(req.body.code || "")
                .trim()
                .toUpperCase();

        const plan = db.prepare(`
            SELECT *
            FROM plans
            WHERE id=?
            AND active=1
        `).get(planId);

        if (!plan) {

            return res.status(404).json({
                error: "پلن پیدا نشد."
            });

        }

        if (!code) {

            return res.json({

                valid: false,

                subtotal: plan.price,

                discount: 0,

                total: plan.price

            });

        }

        const coupon = db.prepare(`
            SELECT *
            FROM coupons
            WHERE code=?
            AND active=1
        `).get(code);

        if (!coupon) {

            return res.json({

                valid: false,

                subtotal: plan.price,

                discount: 0,

                total: plan.price

            });

        }

        const discount =
            Math.floor(
                plan.price *
                coupon.percent /
                100
            );

        res.json({

            valid: true,

            percent: coupon.percent,

            subtotal: plan.price,

            discount,

            total:
                plan.price - discount
        });

    }
);


// ===============================
// CREATE ORDER
// ===============================

app.post(
    "/api/order",
    auth,
    (req, res) => {

        const planId =
            Number(req.body.plan_id);

        const couponCode =
            String(req.body.coupon || "")
                .trim()
                .toUpperCase();

        const plan = db.prepare(`
            SELECT *
            FROM plans
            WHERE id=?
            AND active=1
        `).get(planId);

        if (!plan) {

            return res.status(404).json({
                error: "پلن پیدا نشد."
            });

        }

        let discount = 0;
        let couponId = null;

        if (couponCode) {

            const coupon = db.prepare(`
                SELECT *
                FROM coupons
                WHERE code=?
                AND active=1
            `).get(couponCode);

            if (!coupon) {

                return res.status(400).json({
                    error: "کد تخفیف نامعتبر است."
                });

            }

            couponId = coupon.id;

            discount =
                Math.floor(
                    plan.price *
                    coupon.percent /
                    100
                );
        }

        const total =
            plan.price - discount;

        const result = db.prepare(`
            INSERT INTO orders
            (
                user_id,
                plan_id,
                coupon_id,
                subtotal,
                discount,
                total
            )
            VALUES(?,?,?,?,?,?)
        `).run(

            req.session.userId,

            plan.id,

            couponId,

            plan.price,

            discount,

            total
        );

        res.json({

            ok: true,

            order_id:
                Number(result.lastInsertRowid),

            total

        });

    }
);


// ===============================
// CUSTOMER DASHBOARD
// ===============================

app.get(
    "/api/dashboard",
    auth,
    (req, res) => {

        const userId =
            req.session.userId;

        const services =
            db.prepare(`
                SELECT
                    s.id,
                    s.status,
                    s.config,
                    s.external_id,
                    s.expires_at,
                    p.name,
                    p.days,
                    p.gb,
                    p.price
                FROM services s

                JOIN plans p
                ON p.id=s.plan_id

                WHERE s.user_id=?

                ORDER BY s.id DESC
            `).all(userId);

        const orders =
            db.prepare(`
                SELECT
                    o.id,
                    o.total,
                    o.discount,
                    o.status,
                    o.payment_status,
                    o.created_at,
                    p.name AS plan_name

                FROM orders o

                JOIN plans p
                ON p.id=o.plan_id

                WHERE o.user_id=?

                ORDER BY o.id DESC
            `).all(userId);

        res.json({

            services,

            orders

        });

    }
);


