// ===============================
// ADMIN CREATE VPN SERVICE
// ===============================

app.post(
    "/api/admin/services",
    admin,
    (req, res) => {

        const userId =
            Number(req.body.user_id);

        const planId =
            Number(req.body.plan_id);

        const orderId =
            req.body.order_id
                ? Number(req.body.order_id)
                : null;

        const config =
            String(req.body.config || "");

        const externalId =
            String(req.body.external_id || "");

        const expiresAt =
            req.body.expires_at || null;

        const user =
            db.prepare(
                "SELECT id FROM users WHERE id=?"
            ).get(userId);

        const plan =
            db.prepare(
                "SELECT id FROM plans WHERE id=?"
            ).get(planId);

        if (!user || !plan) {

            return res.status(404).json({
                error: "کاربر یا پلن پیدا نشد."
            });

        }

        const result =
            db.prepare(`
                INSERT INTO services
                (
                    user_id,
                    order_id,
                    plan_id,
                    config,
                    external_id,
                    status,
                    expires_at
                )
                VALUES(?,?,?,?,?,'active',?)
            `).run(

                userId,

                orderId,

                planId,

                config,

                externalId,

                expiresAt
            );

        if (orderId) {

            db.prepare(`
                UPDATE orders

                SET status='completed',
                    payment_status='paid'

                WHERE id=?
            `).run(orderId);

        }

        res.json({

            ok: true,

            service_id:
                Number(result.lastInsertRowid)

        });

    }
);


